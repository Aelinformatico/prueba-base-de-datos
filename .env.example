NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key
NEXT_PUBLIC_GOOGLE_MAP_ID=your-google-map-id
# Server only. Never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SECRET_KEY=your-secret-key
# Legacy alternative if the project still uses the old service_role JWT:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
